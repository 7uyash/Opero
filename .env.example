# ---- Core ----
NODE_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL / Redis (docker compose defaults)
DATABASE_URL=postgresql://lfm:lfm@localhost:15432/lfm?schema=public
TEST_DATABASE_URL=postgresql://lfm:lfm@localhost:15432/lfm_test?schema=public
REDIS_URL=redis://localhost:6379

# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Secret used to sign/hash session tokens. Same generator as above.
SESSION_SECRET=

# ---- Optional provider app credentials ----
# Gmail / Google Workspace (OAuth app from Google Cloud Console; redirect URI: <APP_URL>/api/integrations/callback/gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Meta app (developers.facebook.com) for WhatsApp webhooks and Facebook/Instagram lead ads
# OAuth redirect URI: <APP_URL>/api/integrations/callback/meta
META_APP_ID=
META_APP_SECRET=
# Any random string; enter the same value as the "Verify token" when configuring webhooks in Meta
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0
