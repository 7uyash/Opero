# Production settings for docker-compose.prod.yml. Copy to .env.production and fill in.
# Never commit .env.production. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   (or: openssl rand -base64 32)

# ---- Required ----
# Public address people use. Links in emails, unsubscribe links and OAuth redirects use it.
APP_URL=https://leads.example.com
# Domain for the built-in HTTPS proxy (--profile https). Usually APP_URL without https://.
DOMAIN=leads.example.com

# Database password: letters and digits only (it goes into a connection URL), e.g. `openssl rand -hex 24`.
# Named LFM_… so a POSTGRES_PASSWORD already set on the machine can't override it.
LFM_DB_PASSWORD=
# Encrypts stored integration credentials (AES-256-GCM). 32 random bytes, base64.
# Keep a copy somewhere safe: if it is lost, every connection has to be set up again.
ENCRYPTION_KEY=
# Signs sessions, OAuth state and unsubscribe links. 32 random bytes, base64; different from ENCRYPTION_KEY.
SESSION_SECRET=

# ---- Optional: where the web app listens on the host ----
# 127.0.0.1 means "only through a reverse proxy on this machine" (Caddy profile or your own).
WEB_BIND=127.0.0.1
WEB_PORT=3000
# Only for a private test install without HTTPS:
# ALLOW_INSECURE_HTTP=1

# ---- Optional: provider apps (leave empty to hide those integrations as "requires setup") ----
# Gmail — Google Cloud OAuth client. Redirect URI: <APP_URL>/api/integrations/callback/gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Meta app for WhatsApp Cloud API webhooks and Facebook/Instagram lead ads.
# OAuth redirect URI: <APP_URL>/api/integrations/callback/meta
META_APP_ID=
META_APP_SECRET=
# Random string; enter the same value as "Verify token" in the Meta webhook settings.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0

# ---- Optional: tuning ----
# LOG_LEVEL=info
# FOLLOWUP_SWEEP_MS=15000
